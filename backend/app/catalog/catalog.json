{
  "use_cases": [
    {
      "id": "chat",
      "name": "Chat",
      "description": "General assistant: questions, writing, summarizing."
    },
    {
      "id": "reasoning",
      "name": "Reasoning",
      "description": "Thinks step by step before answering. Better at math, logic and planning; slower."
    },
    {
      "id": "code",
      "name": "Code",
      "description": "Writing, explaining and fixing code."
    },
    {
      "id": "agent",
      "name": "Agent & tools",
      "description": "Can use tools: web search, and agent mode (editing files, running commands). Bigger models follow instructions better."
    },
    {
      "id": "vision",
      "name": "Vision",
      "description": "Understands images you attach: screenshots, photos, documents."
    },
    {
      "id": "embedding",
      "name": "Embeddings",
      "description": "Turns text into vectors for search and RAG. Used by apps, not for chatting."
    },
    {
      "id": "image",
      "name": "Image generation",
      "description": "Creates images from text prompts."
    },
    {
      "id": "transcription",
      "name": "Speech to text",
      "description": "Transcribes recordings and dictation into text."
    },
    {
      "id": "speech",
      "name": "Text to speech",
      "description": "Reads text aloud in a natural voice."
    }
  ],
  "engines": [
    {
      "id": "ollama",
      "name": "Ollama",
      "available": true
    },
    {
      "id": "image",
      "name": "Image engine (diffusers + PyTorch)",
      "available": true,
      "install_size_gb": 7,
      "note": "Installed automatically with your first image model (about 7 GB, one time)."
    },
    {
      "id": "audio",
      "name": "Audio engine (faster-whisper + Kokoro)",
      "available": true,
      "install_size_gb": 2,
      "note": "Installed automatically with your first audio model (about 2 GB with GPU libraries, one time)."
    }
  ],
