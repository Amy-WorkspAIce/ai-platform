# Copy to .env and adjust. All settings are optional.

# API key for /v1 and /api. Leave unset to auto-generate on first start (printed in logs).
# AMY_API_KEY=amy-change-me

# Ollama server. Bundled inside the "full" image at the default below.
# Point at an external server for the "slim" image, or set empty to disable.
# AMY_OLLAMA_URL=http://127.0.0.1:11434

# Extra OpenAI-compatible providers (JSON list).
# AMY_PROVIDERS=[{"name":"vllm","base_url":"http://vllm:8000/v1"},{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-..."}]

# Browser origins of other apps allowed to call this API.
# AMY_CORS_ORIGINS=http://docs.local:8080

# File ownership of /data (Unraid: 99 / 100).
# PUID=1000
# PGID=1000
